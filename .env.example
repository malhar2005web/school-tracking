# SchoolTrack Production & Docker Compose Environment Variables
# Copy to .env for production deployment or local orchestration.

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production
API_HTTP_PORT=5080
ADMIN_HTTP_PORT=5081

# PostgreSQL 17 Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=schooltrack
POSTGRES_USER=schooltrack_app
POSTGRES_PASSWORD=change_me_super_secure_production_password_2026!

# Redis Cache & SignalR Backplane
REDIS_PORT=6379
REDIS_PASSWORD=change_me_super_secure_redis_password_2026!

# JWT Cryptographic Secrets (Minimum 32 characters, high entropy)
JWT_ISSUER=SchoolTrack.Api
JWT_AUDIENCE=SchoolTrack.Clients
JWT_SECRET_KEY=SchoolTrack_ProductionMasterKey_MustBeAtLeast32CharsLong!

# Connection Strings
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=schooltrack;Username=schooltrack_app;Password=change_me_super_secure_production_password_2026!
ConnectionStrings__Redis=localhost:6379,password=change_me_super_secure_redis_password_2026!

# Frontend Admin Base URL
ApiBaseUrl=http://localhost:5080
