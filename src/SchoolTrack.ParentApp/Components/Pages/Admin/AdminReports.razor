@page "/admin/reports"
@layout Layout.AdminLayout
@inject IApiClient ApiClient
@inject AdminAuthStateProvider AuthState

<PageTitle>Reports & Compliance â€” SchoolTrack</PageTitle>

<div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Title Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--color-on-surface-variant); margin-bottom: 0.25rem;">
                <span>District Compliance</span>
                <span class="material-symbols-outlined" style="font-size: 0.875rem;">chevron_right</span>
                <span style="color: var(--color-primary);">Audits, RFID Tap Ledger & Safety SLAs</span>
            </div>
            <h1 style="font-size: 20px; line-height: 1.2; font-weight: 800; color: var(--color-on-surface); margin: 0; letter-spacing: -0.02em;">Reports & Safety Compliance</h1>
            <p style="font-size: 0.875rem; color: var(--color-on-surface-variant); margin: 0.25rem 0 0 0;">Safety audits, passenger boarding integrity, and hardware tap verification logs</p>
        </div>

        <button class="clay-btn clay-btn-primary" type="button" @onclick="DownloadAuditReport">
            <span class="material-symbols-outlined" style="font-size: 1.125rem;">picture_as_pdf</span>
            <span>Download Monthly Compliance PDF</span>
        </button>
    </div>

    <!-- 3 Compliance Bento Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
        <div class="clay-card" style="padding: 1.5rem; background: #ffffff;">
            <span style="font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; color: var(--color-on-surface-variant);">Monthly On-Time SLA</span>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.5rem;">
                <span style="font-size: 2rem; font-weight: 800; color: var(--color-secondary);">98.4%</span>
                <span style="font-size: 0.875rem; color: var(--color-on-surface-variant);">Target: 95.0%</span>
            </div>
            <p style="font-size: 0.75rem; color: var(--color-on-surface-variant); margin-top: 0.5rem;">24 Corridor routes evaluated across 420 completed trips this month.</p>
        </div>

        <div class="clay-card" style="padding: 1.5rem; background: #ffffff;">
            <span style="font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; color: var(--color-on-surface-variant);">RFID Scan Integrity</span>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.5rem;">
                <span style="font-size: 2rem; font-weight: 800; color: var(--color-primary);">99.2%</span>
                <span style="font-size: 0.875rem; color: var(--color-on-surface-variant);">Verified Taps</span>
            </div>
            <p style="font-size: 0.75rem; color: var(--color-on-surface-variant); margin-top: 0.5rem;">Ethernet readers operational with sub-second gateway latency.</p>
        </div>

        <div class="clay-card" style="padding: 1.5rem; background: #ffffff;">
            <span style="font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; color: var(--color-on-surface-variant);">Safety Exceptions & Unknown Taps</span>
            <div style="display: flex; align-items: baseline; gap: 0.5rem; margin-top: 0.5rem;">
                <span style="font-size: 2rem; font-weight: 800; color: var(--color-tertiary);">2</span>
                <span style="font-size: 0.875rem; color: var(--color-on-surface-variant);">Unassigned Badges</span>
            </div>
            <p style="font-size: 0.75rem; color: var(--color-on-surface-variant); margin-top: 0.5rem;">All unknown badge scans recorded with timestamp and bus sensor telemetry.</p>
        </div>
    </div>

    <!-- Unknown Tap Ledger Table -->
    <div class="clay-card" style="padding: 1.5rem; background: #ffffff;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="material-symbols-outlined" style="color: var(--color-tertiary); font-size: 1.5rem;">emergency</span>
                <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--color-on-surface); margin: 0;">Unassigned RFID Taps Audit Ledger</h2>
            </div>
            <span class="clay-badge clay-badge-neutral">Safety Protocol Compliant</span>
        </div>

        <div class="clay-table-container">
            <table class="clay-table">
                <thead>
                    <tr>
                        <th>Scanned Card UID</th>
                        <th>Bus & Gateway</th>
                        <th>Timestamp</th>
                        <th>Scan Coordinates</th>
                        <th>Security Action Taken</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <span class="clay-badge clay-badge-error">ST-UNK-9941</span>
                        </td>
                        <td>
                            <span style="font-weight: 700;">Bus #08 â€¢ Gateway ETH-08</span>
                        </td>
                        <td>
                            <span>Today at 07:38:12 AM</span>
                        </td>
                        <td>
                            <span>37.7710, -122.4180 (Near Maple Blossom)</span>
                        </td>
                        <td>
                            <span class="clay-badge clay-badge-tertiary">Logged & Driver Prompted</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span class="clay-badge clay-badge-error">ST-UNK-8120</span>
                        </td>
                        <td>
                            <span style="font-weight: 700;">Bus #14 â€¢ Gateway ETH-14</span>
                        </td>
                        <td>
                            <span>Yesterday at 03:42:01 PM</span>
                        </td>
                        <td>
                            <span>37.7810, -122.4140 (School Turnstile)</span>
                        </td>
                        <td>
                            <span class="clay-badge clay-badge-secondary">Resolved & Issued Temp Pass</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private void DownloadAuditReport() { }
}



