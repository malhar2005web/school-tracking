@page "/admin"
@page "/admin/dashboard"
@layout Layout.AdminLayout
@inject IApiClient ApiClient
@inject AdminAuthStateProvider AuthState
@inject LiveFleetTrackingService TrackingService
@inject NavigationManager Navigation

<div style="display:flex; flex-direction:column; gap:1rem; width:100%; user-select:none;">
    
    <!-- Top Mobile Ambience & Title Strip -->
    <div style="display:flex; flex-direction:column; gap:0.5rem;">
        <div style="display:flex; align-items:center; justify-content:space-between;">
            <div style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.25rem 0.65rem; border-radius:9999px; background:#eeecff; font-size:11px; font-weight:700; color:#4338ca;">
                <span style="width:7px; height:7px; border-radius:50%; background:#0c6b55; display:inline-block; animation:pulse 2s infinite;"></span>
                <span>SUB-SECOND TELEMETRY</span>
            </div>
            <span class="clay-badge-mint" style="font-size:10px;">Phase 2 Active</span>
        </div>
        
        <div>
            <h1 style="font-size:20px; font-weight:800; color:#181930; margin:0; line-height:1.2;">Oakridge Fleet Radar</h1>
        </div>

        <!-- Quick Action Mobile Pills -->
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:0.5rem; margin-top:0.25rem;">
            <button class="clay-btn clay-btn-surface" style="padding:0.5rem 0.25rem; font-size:11px; font-weight:800; display:flex; flex-direction:column; align-items:center; gap:3px;" type="button" @onclick='() => Navigation.NavigateTo("/admin/fleet-radar")'>
                <span class="material-symbols-outlined" style="color:#4338ca; font-size:18px;">map</span>
                <span>Map Radar</span>
            </button>
            <button class="clay-btn clay-btn-surface" style="padding:0.5rem 0.25rem; font-size:11px; font-weight:800; display:flex; flex-direction:column; align-items:center; gap:3px;" type="button" @onclick="RefreshData">
                <span class="material-symbols-outlined" style="color:#0c6b55; font-size:18px;">sync</span>
                <span>Sync Mesh</span>
            </button>
            <button class="clay-btn clay-btn-primary" style="padding:0.5rem 0.25rem; font-size:11px; font-weight:800; display:flex; flex-direction:column; align-items:center; gap:3px; background:#4338ca;" type="button" @onclick="() => _showBroadcastModal = true">
                <span class="material-symbols-outlined" style="font-size:18px;">campaign</span>
                <span>Broadcast</span>
            </button>
        </div>
    </div>

    <!-- 2x2 Bento Mobile KPI Cards (Clean & Uncluttered) -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.625rem;">
        <!-- Card 1: Active Fleet -->
        <div class="clay-card" style="padding:0.875rem; background:#ffffff; border-radius:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <span style="font-size:11px; font-weight:800; text-transform:uppercase; color:#797584; letter-spacing:0.04em;">Active Fleet</span>
                <span class="material-symbols-outlined" style="font-size:18px; color:#4338ca;">directions_bus</span>
            </div>
            <div style="display:flex; align-items:baseline; gap:0.25rem; margin-top:0.5rem;">
                <span style="font-size:24px; font-weight:900; color:#181930; line-height:1;">@_summary.ActiveFleetCount</span>
                <span style="font-size:12px; color:#797584; font-weight:700;">/ @_summary.TotalFleetCount</span>
            </div>
        </div>

        <!-- Card 2: Students Boarded -->
        <div class="clay-card" style="padding:0.875rem; background:#ffffff; border-radius:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <span style="font-size:11px; font-weight:800; text-transform:uppercase; color:#797584; letter-spacing:0.04em;">Boarded</span>
                <span class="material-symbols-outlined" style="font-size:18px; color:#0c6b55;">how_to_reg</span>
            </div>
            <div style="display:flex; align-items:baseline; gap:0.25rem; margin-top:0.5rem;">
                <span style="font-size:24px; font-weight:900; color:#181930; line-height:1;">@_summary.StudentsBoardedCount</span>
                <span style="font-size:12px; color:#797584; font-weight:700;">/ @_summary.TotalStudentsCount</span>
            </div>
        </div>

        <!-- Card 3: Gateways Online -->
        <div class="clay-card" style="padding:0.875rem; background:#ffffff; border-radius:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <span style="font-size:11px; font-weight:800; text-transform:uppercase; color:#797584; letter-spacing:0.04em;">Gateways</span>
                <span class="material-symbols-outlined" style="font-size:18px; color:#765b00;">router</span>
            </div>
            <div style="display:flex; align-items:baseline; gap:0.25rem; margin-top:0.5rem;">
                <span style="font-size:24px; font-weight:900; color:#181930; line-height:1;">@_summary.GatewaysOnlineCount</span>
                <span style="font-size:12px; color:#797584; font-weight:700;">/ @_summary.TotalGatewaysCount</span>
            </div>
        </div>

        <!-- Card 4: Active Alerts -->
        <div class="clay-card" style="padding:0.875rem; background:#ffffff; border-radius:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <span style="font-size:11px; font-weight:800; text-transform:uppercase; color:#797584; letter-spacing:0.04em;">Road Alerts</span>
                <span class="material-symbols-outlined" style="font-size:18px; color:#ba1a1a;">warning</span>
            </div>
            <div style="display:flex; align-items:baseline; gap:0.25rem; margin-top:0.5rem;">
                <span style="font-size:24px; font-weight:900; color:@(_summary.ActiveAlertsCount > 0 ? "#ba1a1a" : "#181930"); line-height:1;">@_summary.ActiveAlertsCount</span>
            </div>
        </div>
    </div>

    <!-- Active Fleet Telemetry Mobile Cards -->
    <div class="clay-card" style="padding:1rem; background:#ffffff; border-radius:1.25rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
            <div style="display:flex; align-items:center; gap:0.4rem;">
                <span class="material-symbols-outlined" style="color:#4338ca; font-size:18px;">directions_bus</span>
                <h2 style="font-size:15px; font-weight:800; color:#181930; margin:0;">Active Fleet Telemetry</h2>
            </div>
            <button class="clay-btn clay-btn-surface" style="padding:0.25rem 0.5rem; font-size:10px; font-weight:800;" type="button" @onclick='() => Navigation.NavigateTo("/admin/fleet-radar")'>
                Radar Map →
            </button>
        </div>

        <div style="display:flex; flex-direction:column; gap:0.625rem;">
            @foreach (var bus in _summary.ActiveBuses)
            {
                <div class="clay-card" style="padding:0.75rem; border-radius:1rem; background:#fbf8ff; border:1px solid rgba(24,25,48,0.06);">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.35rem;">
                        <div>
                            <div style="display:flex; align-items:center; gap:0.35rem;">
                                <span style="font-size:14px; font-weight:800; color:#181930;">@bus.BusNumber</span>
                                @if (bus.Status == "OnSchedule")
                                {
                                    <span class="clay-badge-mint" style="font-size:9px; padding:1px 5px;">ON-TIME</span>
                                }
                                else if (bus.Status == "Delayed")
                                {
                                    <span class="clay-badge-error" style="font-size:9px; padding:1px 5px;">DELAYED</span>
                                }
                                else
                                {
                                    <span class="clay-badge-secondary" style="font-size:9px; padding:1px 5px;">@bus.Status</span>
                                }
                            </div>
                            <span style="font-size:11px; color:#484552;">@bus.RouteName</span>
                        </div>
                        <div style="text-align:right;">
                            <span style="font-size:13px; font-weight:800; color:#4338ca;">@Math.Round(bus.SpeedMph) mph</span>
                            <div style="font-size:10px; color:#797584;">@bus.DriverName</div>
                        </div>
                    </div>

                    <!-- Occupancy Bar & Next Stop -->
                    <div style="margin-top:0.4rem; padding-top:0.4rem; border-top:1px solid rgba(24,25,48,0.06); display:flex; flex-direction:column; gap:0.35rem;">
                        <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                            <div style="display:flex; align-items:center; gap:0.35rem; font-size:10px; font-weight:700; color:#484552;">
                                <span>Occupancy:</span>
                                <span style="color:#181930; font-weight:800;">@bus.PassengerCount / @bus.Capacity</span>
                            </div>
                            <div style="background:#eeecff; padding:2px 6px; border-radius:6px; font-size:10px; font-weight:700; color:#4338ca; white-space:nowrap; text-overflow:ellipsis; overflow:hidden; max-width:62%;">
                                ETA: @bus.NextStopEtaMinutes m • @bus.NextStopName
                            </div>
                        </div>
                        <div class="clay-progress-track" style="height:4px;">
                            <div class="clay-progress-fill-secondary" style="width:@((bus.PassengerCount * 100) / bus.Capacity)%;"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- RFID Live Stream Section -->
    <div class="clay-card" style="padding:1rem; background:#ffffff; border-radius:1.25rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
            <div style="display:flex; align-items:center; gap:0.4rem;">
                <span style="width:7px; height:7px; border-radius:50%; background:#0c6b55; display:inline-block;" class="pulse-dot"></span>
                <h2 style="font-size:15px; font-weight:800; color:#181930; margin:0;">RFID Smart Tap Feed</h2>
            </div>
            <span class="clay-badge-secondary" style="font-size:9px;">Live Gateway</span>
        </div>

        <div style="display:flex; flex-direction:column; gap:0.5rem; max-height:260px; overflow-y:auto;">
            @foreach (var tap in _summary.RecentTaps.Take(6))
            {
                <div class="clay-inset" style="padding:0.625rem 0.75rem; display:flex; align-items:center; gap:0.625rem;">
                    <div style="width:2rem; height:2rem; border-radius:50%; background:#e8f8f3; color:#0c6b55; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        <span class="material-symbols-outlined" style="font-size:16px;">contactless</span>
                    </div>
                    <div style="flex:1; min-width:0;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <span style="font-size:12px; font-weight:800; color:#181930; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@tap.StudentName</span>
                            <span style="font-size:10px; color:#797584;">@tap.Timestamp.ToString("hh:mm tt")</span>
                        </div>
                        <div style="display:flex; align-items:center; gap:0.35rem; margin-top:1px;">
                            <span class="clay-badge-mint" style="font-size:9px; padding:1px 4px;">@tap.EventType</span>
                            <span style="font-size:10px; color:#484552;">@tap.BusNumber • @tap.Grade</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <button class="clay-btn clay-btn-surface" style="width:100%; height:2.5rem; font-size:12px; font-weight:700; margin-top:0.75rem;" type="button" @onclick='() => Navigation.NavigateTo("/admin/students")'>
            View Full Student Roster (412 Registered) →
        </button>
    </div>

    <!-- Mobile District Radio Dispatch Strip -->
    <div class="clay-card" style="padding:1rem; background:#ffffff; border-radius:1.25rem;">
        <div style="display:flex; align-items:center; gap:0.4rem; margin-bottom:0.5rem;">
            <span class="material-symbols-outlined" style="color:#4338ca; font-size:18px;">podcasts</span>
            <h3 style="font-size:14px; font-weight:800; color:#181930; margin:0;">Quick Radio Dispatch</h3>
        </div>
        <div style="display:flex; gap:0.5rem;">
            <div class="clay-inset" style="flex:1; height:2.75rem; display:flex; align-items:center; padding:0 0.75rem;">
                <input style="width:100%; background:transparent; border:none; outline:none; font-size:13px; color:#181930;" placeholder="Broadcast radio text to all buses..." @bind="_broadcastText" />
            </div>
            <button class="clay-btn clay-btn-primary" style="height:2.75rem; padding:0 1rem; background:#4338ca;" type="button" @onclick="SendQuickRadioPush">
                <span class="material-symbols-outlined" style="font-size:18px;">send</span>
            </button>
        </div>
    </div>
</div>

@if (_showBroadcastModal)
{
    <!-- Mobile District Broadcaster Modal -->
    <div style="position:fixed; inset:0; background:rgba(24,25,48,0.55); backdrop-filter:blur(6px); z-index:3000; display:flex; align-items:center; justify-content:center; padding:1.25rem;">
        <div class="clay-card" style="width:100%; max-width:24rem; padding:1.25rem; background:#ffffff; border-radius:1.5rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <span class="material-symbols-outlined" style="color:#4338ca; font-size:22px;">campaign</span>
                    <h3 style="font-size:16px; font-weight:800; margin:0; color:#181930;">District Broadcaster</h3>
                </div>
                <button type="button" style="background:none; border:none; cursor:pointer;" @onclick="() => _showBroadcastModal = false">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <p style="font-size:12px; color:#484552; margin:0 0 0.75rem 0;">
                Push priority broadcast notification to all drivers, parents, and security monitors.
            </p>
            <div class="clay-inset" style="padding:0.75rem; margin-bottom:1rem; border-radius:1rem;">
                <textarea style="width:100%; height:4.5rem; background:transparent; border:none; outline:none; font-size:13px; resize:none; color:#181930;" placeholder="Weather advisory or traffic delay notification..." @bind="_broadcastModalMessage"></textarea>
            </div>
            <div style="display:flex; justify-content:flex-end; gap:0.5rem;">
                <button class="clay-btn clay-btn-surface" style="padding:0.5rem 1rem; font-size:12px;" type="button" @onclick="() => _showBroadcastModal = false">Cancel</button>
                <button class="clay-btn clay-btn-primary" style="padding:0.5rem 1rem; font-size:12px; background:#4338ca;" type="button" @onclick="SendDistrictBroadcast">Send Broadcast</button>
            </div>
        </div>
    </div>
}

@code {
    private DashboardSummaryViewModel _summary = new();
    private bool _showBroadcastModal = false;
    private string _broadcastText = string.Empty;
    private string _broadcastModalMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();

        // Connect to SignalR real-time stream
        try
        {
            await TrackingService.StartAsync();
            TrackingService.OnBoardingNotificationReceived += HandleBoardingNotification;
            TrackingService.OnBusLocationReceived += HandleBusLocation;
        }
        catch { }
    }

    private async Task LoadDashboard()
    {
        _summary = await ApiClient.GetDashboardSummaryAsync(AuthState.CurrentSession.SchoolId);
    }

    private async Task RefreshData()
    {
        await LoadDashboard();
        StateHasChanged();
    }

    private void HandleBoardingNotification(BoardingNotificationDto dto)
    {
        InvokeAsync(() =>
        {
            _summary.RecentTaps.Insert(0, new LiveRfidTapItem
            {
                StudentName = dto.StudentName,
                CardSerialNumber = dto.AdmissionNumber,
                Grade = dto.ClassName,
                BusNumber = dto.BusNumber,
                StopName = dto.StopName ?? "Transit Gate",
                EventType = dto.ScanType,
                Timestamp = dto.ScannedAt.LocalDateTime,
                IsVerified = true,
                ParentNotified = true
            });
            if (_summary.RecentTaps.Count > 15)
            {
                _summary.RecentTaps.RemoveAt(_summary.RecentTaps.Count - 1);
            }
            StateHasChanged();
        });
    }

    private void HandleBusLocation(LatestBusLocationDto dto)
    {
        InvokeAsync(() =>
        {
            var bus = _summary.ActiveBuses.FirstOrDefault(b => b.BusId == dto.BusId);
            if (bus != null)
            {
                bus.Latitude = (double)dto.Latitude;
                bus.Longitude = (double)dto.Longitude;
                bus.SpeedMph = (double)dto.SpeedKmh * 0.621371;
                bus.LastHeartbeatUtc = dto.RecordedAt.UtcDateTime;
                StateHasChanged();
            }
        });
    }

    private void SendQuickRadioPush()
    {
        _broadcastText = string.Empty;
    }

    private void SendDistrictBroadcast()
    {
        _showBroadcastModal = false;
        _broadcastModalMessage = string.Empty;
    }
}
