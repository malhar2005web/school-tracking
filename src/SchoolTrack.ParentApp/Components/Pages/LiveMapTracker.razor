@page "/live-map"
@inject NavigationManager Navigation
@inject ParentAuthState AuthState
@inject IParentApiClient ApiClient
@inject ParentTrackingHubService TrackingHub
@inject IParentNotificationService NotificationService
@inject IJSRuntime JS
@implements IDisposable

<div style="display:flex; flex-direction:column; width:100%; position:relative; user-select:none; max-width:440px; margin:0 auto;">
    <!-- Shift Direction Toggle (Morning / Evening) -->
    <div style="padding:0.25rem 1rem 0 1rem;">
        <div style="display:flex; background:#eeecff; padding:4px; border-radius:12px; gap:4px; box-shadow:inset 0 1px 3px rgba(24,25,48,0.06);">
            <button type="button"
                    style="flex:1; border:none; padding:6px 10px; border-radius:8px; font-size:11px; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:4px; transition:all 0.2s; @(AuthState.CurrentShift == "Morning" ? "background:#644bba; color:#ffffff; box-shadow:0 3px 8px rgba(100,75,186,0.3);" : "background:transparent; color:#484552;")"
                    @onclick='() => SwitchShift("Morning")'>
                <span class="material-symbols-outlined" style="font-size:15px;">wb_sunny</span>
                <span>Morning (To School)</span>
            </button>
            <button type="button"
                    style="flex:1; border:none; padding:6px 10px; border-radius:8px; font-size:11px; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:4px; transition:all 0.2s; @(AuthState.CurrentShift == "Evening" ? "background:#644bba; color:#ffffff; box-shadow:0 3px 8px rgba(100,75,186,0.3);" : "background:transparent; color:#484552;")"
                    @onclick='() => SwitchShift("Evening")'>
                <span class="material-symbols-outlined" style="font-size:15px;">wb_twilight</span>
                <span>Evening (To Home)</span>
            </button>
        </div>
    </div>

    <!-- Top Floating Clay Route Status Card -->
    <div style="padding:0.375rem 1rem 0.375rem 1rem;">
        <div class="clay-card" style="padding:0.75rem 1rem; display:flex; flex-direction:column; gap:0.5rem;">
            <div style="display:flex; align-items:center; justify-content:space-between;">
                <div style="display:flex; align-items:center; gap:0.625rem;">
                    <div style="width:2.5rem; height:2.5rem; border-radius:50%; background:#ffd66b; color:#241a00; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 10px rgba(233,194,89,0.35), inset 0 2px 2px rgba(255,255,255,0.7);">
                        <span class="material-symbols-outlined" style="font-size:22px;">directions_bus</span>
                    </div>
                    <div>
                        <div style="display:flex; align-items:center; gap:0.375rem;">
                            <span style="font-size:17px; font-weight:800; color:#181930;">@(_trip?.BusNumber ?? "Bus #14")</span>
                            <span class="clay-badge @(_trip?.IsOnBus == true ? "clay-badge-tertiary" : (_trip?.IsTripClosed == true ? "clay-badge-primary" : "clay-badge-secondary"))" style="font-size:10px; padding:2px 6px;">
                                @(_trip?.ChildInOutStatus ?? "IN (On-Bus)")
                            </span>
                        </div>
                        <p style="font-size:11px; color:#484552; margin:0;">@(_trip?.RouteName ?? "Morning Route A")</p>
                    </div>
                </div>

                <div style="display:flex; flex-direction:column; align-items:flex-end;">
                    <div style="display:flex; align-items:center; gap:0.25rem; color:#644bba; font-size:12px; font-weight:700; background:#e7e6ff; padding:0.2rem 0.5rem; border-radius:9999px;">
                        <span class="material-symbols-outlined" style="font-size:14px;">speed</span>
                        <span>@(_currentSpeed.ToString("0")) mph</span>
                    </div>
                    <span style="font-size:10px; color:#484552; margin-top:2px;">
                        @(ActiveChild?.FullName ?? "Leo") • Strictly Private
                    </span>
                </div>
            </div>

            <!-- Segmented Trip Progress -->
            <div style="display:flex; flex-direction:column; gap:0.25rem; padding-top:0.125rem;">
                <div style="display:flex; align-items:center; justify-content:space-between; font-size:11px; font-weight:700; color:#484552;">
                    <span style="display:flex; align-items:center; gap:0.25rem;">
                        <span style="width:6px; height:6px; border-radius:50%; background:#0c6b55; animation:pulse 2s infinite;"></span>
                        Stop @(_trip?.CurrentStopIndex ?? 4) of @(_trip?.TotalStops ?? 6) reached
                    </span>
                    <span style="color:#644bba;">@(_trip?.CompletionPercentage ?? 65)% Completed</span>
                </div>

                <div class="clay-progress-track">
                    <div class="clay-progress-fill-primary" style="width:@(_trip?.CompletionPercentage ?? 65)%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Leaflet Map Canvas Container -->
    <div style="position:relative; width:100%; height:340px; margin:0.125rem 0;">
        <div id="parent-map-container" style="width:100%; height:100%; background:#e7e6ff;"></div>

        <!-- Live Street Floating Badge (Bottom Left) -->
        <div style="position:absolute; bottom:1rem; left:1rem; z-index:1000; background:rgba(255,255,255,0.92); backdrop-filter:blur(8px); padding:0.375rem 0.75rem; border-radius:9999px; box-shadow:0 4px 12px rgba(24,25,48,0.1); display:flex; align-items:center; gap:0.375rem;">
            <span class="material-symbols-outlined" style="font-size:16px; color:#644bba;">location_on</span>
            <span style="font-size:11px; font-weight:700; color:#181930;">@(_trip?.CurrentStreetLocation ?? "Maple Crest Corner near Elm St")</span>
        </div>

        <!-- Quick Map Floating Action Controls (Top Right) -->
        <div style="position:absolute; top:1rem; right:1rem; z-index:1000; display:flex; flex-direction:column; gap:0.5rem;">
            <button aria-label="Re-center bus" style="width:2.5rem; height:2.5rem; border-radius:50%; background:#ffffff; border:none; display:flex; align-items:center; justify-content:center; box-shadow:0 6px 16px rgba(24,25,48,0.12); cursor:pointer;" @onclick="RecenterMap">
                <span class="material-symbols-outlined" style="font-size:20px; color:#644bba;">my_location</span>
            </button>
            <button aria-label="Toggle Route Layer" style="width:2.5rem; height:2.5rem; border-radius:50%; background:#ffffff; border:none; display:flex; align-items:center; justify-content:center; box-shadow:0 6px 16px rgba(24,25,48,0.12); cursor:pointer;" @onclick="ToggleLayer">
                <span class="material-symbols-outlined" style="font-size:20px; color:#484552;">layers</span>
            </button>
        </div>
    </div>

    <!-- Bottom Reassurance Drawer Sheet (Dual-Phase ETA & Close Trip) -->
    <div style="padding:0.5rem 1rem 1rem 1rem; display:flex; flex-direction:column; gap:0.75rem;">
        <div class="clay-card" style="padding:1rem; display:flex; flex-direction:column; gap:0.75rem;">
            <!-- Dual-Phase Dynamic ETA Panel -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
                <!-- 1. Stop ETA (Bus jar pickup point la nahi pohocli) -->
                <div style="padding:0.5rem; border-radius:8px; background:@(_trip?.ChildBoardingPhase == "BeforePickup" ? "#ffd66b" : "#f5f2ff"); border:1px solid @(_trip?.ChildBoardingPhase == "BeforePickup" ? "#cca741" : "#e1e0ff");">
                    <div style="font-size:10px; font-weight:700; color:#484552; text-transform:uppercase;">1. To Pickup Stop</div>
                    <div style="font-size:12px; font-weight:800; color:#181930; margin:2px 0;">@(_trip?.PickupStopEtaText ?? "7 mins")</div>
                    <div style="font-size:10px; color:#797584; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@(AuthState.CurrentShift == "Morning" ? ActiveChild?.MorningPickupStopName : "Campus Gate")</div>
                </div>

                <!-- 2. Destination ETA (Pickup point varun nighali tar) -->
                <div style="padding:0.5rem; border-radius:8px; background:@(_trip?.ChildBoardingPhase == "OnboardTransit" ? "#ffd66b" : "#f5f2ff"); border:1px solid @(_trip?.ChildBoardingPhase == "OnboardTransit" ? "#cca741" : "#e1e0ff");">
                    <div style="font-size:10px; font-weight:700; color:#484552; text-transform:uppercase;">2. To Destination</div>
                    <div style="font-size:12px; font-weight:800; color:#181930; margin:2px 0;">@(_trip?.DestinationEtaText ?? "18 mins")</div>
                    <div style="font-size:10px; color:#797584; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@(_trip?.DestinationName ?? "School Campus")</div>
                </div>
            </div>

            <!-- Safety Reassurance Checklist -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
                <div class="clay-inset" style="padding:0.375rem 0.5rem; display:flex; align-items:center; gap:0.375rem;">
                    <span class="material-symbols-outlined" style="font-size:16px; color:#0c6b55;">check_circle</span>
                    <span style="font-size:11px; font-weight:700; color:#181930;">Seatbelt Verified</span>
                </div>
                <div class="clay-inset" style="padding:0.375rem 0.5rem; display:flex; align-items:center; gap:0.375rem;">
                    <span class="material-symbols-outlined" style="font-size:16px; color:#0c6b55;">verified</span>
                    <span style="font-size:11px; font-weight:700; color:#181930;">Speed Regulated</span>
                </div>
            </div>

            <!-- Driver & Dispatch Action Buttons -->
            <div style="display:flex; gap:0.5rem; margin-top:0.125rem;">
                <button class="clay-btn clay-btn-primary" style="flex:1; height:2.5rem; font-size:12px;" @onclick="CallDriver">
                    <span class="material-symbols-outlined" style="font-size:16px;">call</span>
                    <span>Call Driver</span>
                </button>
                @if (_trip?.IsTripClosed != true)
                {
                    <button class="clay-btn clay-btn-surface" style="flex:1; height:2.5rem; font-size:12px; color:#0c6b55; border:1px solid #0c6b55; font-weight:700;" @onclick="CloseParentTrip">
                        <span class="material-symbols-outlined" style="font-size:16px;">task_alt</span>
                        <span>Close Trip</span>
                    </button>
                }
                else
                {
                    <button class="clay-btn clay-btn-surface" style="flex:1; height:2.5rem; font-size:12px;" @onclick="ShareJourney">
                        <span class="material-symbols-outlined" style="font-size:16px;">share</span>
                        <span>Share Trip</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private ChildProfileModel? ActiveChild => AuthState.ActiveChild;
    private ChildActiveTripModel? _trip;
    private decimal _currentSpeed = 24m;
    private bool _mapInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChanged;
        TrackingHub.OnBusLocationUpdated += HandleBusLocationUpdated;

        await LoadData();
    }

    private async Task LoadData()
    {
        if (ActiveChild != null)
        {
            _trip = await ApiClient.GetChildActiveTripAsync(ActiveChild.StudentId, AuthState.CurrentShift);
            if (_trip != null)
            {
                _currentSpeed = _trip.SpeedKmh;
            }
        }
    }

    private void SwitchShift(string shift)
    {
        AuthState.SwitchShift(shift);
        _ = RefreshMapForShift();
    }

    private async Task RefreshMapForShift()
    {
        await LoadData();
        if (_mapInitialized && _trip?.Waypoints != null && _trip.Waypoints.Count > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("parentMapInterop.drawRoute", _trip.Waypoints);
                await RecenterMap();
            }
            catch { }
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !_mapInitialized)
        {
            await Task.Delay(200); // Allow DOM container to mount
            try
            {
                var lat = (double)(_trip?.CurrentLatitude ?? 37.7749m);
                var lng = (double)(_trip?.CurrentLongitude ?? -122.4194m);
                var label = _trip?.BusNumber ?? "Bus #14";

                await JS.InvokeVoidAsync("parentMapInterop.initParentMap", "parent-map-container", lat, lng, label);

                if (_trip?.Waypoints != null && _trip.Waypoints.Count > 0)
                {
                    await JS.InvokeVoidAsync("parentMapInterop.drawRoute", _trip.Waypoints);
                }

                _mapInitialized = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Parent map initialization error: {ex.Message}");
            }
        }
    }

    private void HandleAuthStateChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private void HandleBusLocationUpdated(LatestBusLocationDto loc)
    {
        InvokeAsync(async () =>
        {
            _currentSpeed = loc.SpeedKmh;
            if (_mapInitialized)
            {
                try
                {
                    await JS.InvokeVoidAsync("parentMapInterop.updateBusPosition",
                        (double)loc.Latitude, (double)loc.Longitude, (double)loc.SpeedKmh, (double)loc.Heading);
                }
                catch { }
            }
            StateHasChanged();
        });
    }

    private async Task RecenterMap()
    {
        if (_mapInitialized)
        {
            await JS.InvokeVoidAsync("parentMapInterop.recenterMap");
        }
    }

    private void ToggleLayer()
    {
        NotificationService.ShowToast("Map Layer", "OpenStreetMap CartoDB Safety Layer Active", "General");
    }

    private void CallDriver()
    {
        NotificationService.ShowToast("Dialing Driver", $"Calling Robert Jenkins at {_trip?.DriverPhone ?? "+1 555-329-8472"}...", "General");
    }

    private void ShareJourney()
    {
        NotificationService.ShowToast("Link Copied", "Secure live tracking link copied to clipboard for guardians.", "General");
    }

    private async Task CloseParentTrip()
    {
        if (ActiveChild != null)
        {
            await ApiClient.CloseParentTripAsync(ActiveChild.StudentId);
            await LoadData();
            NotificationService.ShowToast("Trip Closed", $"{ActiveChild.FullName}'s safe arrival confirmed and trip closed.", "SafeArrival");
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthStateChanged;
        TrackingHub.OnBusLocationUpdated -= HandleBusLocationUpdated;
    }
}
