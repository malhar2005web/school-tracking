@page "/"
@page "/login"
@layout Layout.LoginLayout
@inject NavigationManager Navigation
@inject ParentAuthState ParentAuth
@inject IParentApiClient ParentApi
@inject DriverAuthState DriverAuth
@inject IDriverApiClient DriverApi
@inject AdminAuthStateProvider AdminAuth
@inject IApiClient AdminApi

<div style="min-height:100vh; background:linear-gradient(180deg, #fbf8ff 0%, #f0edff 100%); padding:1.25rem 1rem 3rem 1rem; display:flex; flex-direction:column; max-width:460px; margin:0 auto; user-select:none; box-sizing:border-box;">
    
    <!-- Top System Live Pill & Badge -->
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; padding-top:env(safe-area-inset-top, 8px);">
        <div style="display:inline-flex; align-items:center; gap:0.375rem; padding:0.375rem 0.75rem; border-radius:9999px; background:#eeecff; box-shadow:0 4px 12px -2px rgba(41,42,66,0.06), inset 1px 1px 2px rgba(255,255,255,0.8);">
            <span style="width:8px; height:8px; border-radius:50%; background:#0c6b55; display:inline-block; animation:pulse 2s infinite;"></span>
            <span style="font-size:11px; font-weight:700; color:#0c6b55; letter-spacing:0.03em;">FLEET SYSTEM ONLINE</span>
        </div>
        <div style="display:inline-flex; align-items:center; gap:0.375rem; padding:0.375rem 0.75rem; border-radius:9999px; background:#e7e6ff; color:#484552; font-size:11px; font-weight:700;">
            <span class="material-symbols-outlined" style="font-size:16px; color:#644bba;">verified</span>
            <span>Unified Edition v2.4</span>
        </div>
    </div>

    <!-- Mascot & Header Section -->
    <div style="position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; margin:0.5rem 0 1rem 0;">
        <div style="position:absolute; width:10rem; height:10rem; border-radius:50%; background:rgba(155,131,246,0.25); filter:blur(24px); z-index:0;"></div>
        
        <div style="position:relative; z-index:1; cursor:pointer;" @onclick="MascotCheer">
            <div style="width:7.5rem; height:7.5rem; border-radius:50%; padding:0.35rem; background:radial-gradient(135deg, #ffffff 0%, #eeecff 100%); box-shadow:0 14px 28px -6px rgba(100,75,186,0.28), 0 6px 14px -2px rgba(24,25,48,0.08), inset 3px 3px 6px rgba(255,255,255,0.95), inset -3px -3px 6px rgba(100,75,186,0.15); display:flex; align-items:center; justify-content:center; transform:@(_cheering ? "scale(1.08)" : "scale(1)"); transition:transform 0.3s ease;">
                <img alt="SchoolTrack Mascot" style="width:100%; height:100%; border-radius:50%; object-fit:contain; pointer-events:none;" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDpLlyM0Broza9BqnBbgTBAhdP3Au4u0jnjcOLNGAdsbzyys417O6aUyWehYNuaZRB1Mw9wTMP6v4ayUVn7a7HCb5CzC1tZ-FIX8_ogG6eud--sgGqXEm9Czvb6keRmAvRFhCGJX7n6Haf8n8QYIVKOHMVDVeLxhflWT1wURn1ztnBhIQlcS23F9GdrI1EL9ckoZScqDdjZK3zPdY_hFHH0KgsDnxmc0xc7si-9LnQ" />
            </div>

            <!-- Speech Bubble -->
            <div style="position:absolute; top:-0.5rem; right:-2rem; background:#ffffff; padding:0.35rem 0.65rem; border-radius:1rem; display:flex; align-items:center; gap:0.25rem; box-shadow:0 8px 18px -3px rgba(41,42,66,0.12), inset 1px 2px 2px rgba(255,255,255,0.9);">
                <span style="font-size:0.9rem;">👋</span>
                <span style="font-size:10px; font-weight:700; color:#181930;">@_speechMessage</span>
            </div>
        </div>
    </div>

    <!-- Title & Subtitle -->
    <div style="text-align:center; margin-bottom:1.25rem;">
        <h1 style="font-size:26px; font-weight:800; color:#181930; letter-spacing:-0.02em; margin:0 0 0.25rem 0;">SchoolTrack</h1>
        <p style="font-size:13px; color:#484552; margin:0;">One Unified Portal for Parents, Drivers & Admins</p>
    </div>

    <!-- Role Selection Tabs -->
    <div style="background:#eeecff; padding:4px; border-radius:1rem; display:flex; gap:4px; margin-bottom:1.25rem; box-shadow:inset 0 1px 3px rgba(24,25,48,0.06);">
        <button type="button"
                style="flex:1; border:none; padding:0.6rem 0.5rem; border-radius:0.75rem; font-size:12px; font-weight:800; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:5px; transition:all 0.2s; @(_selectedRole == "Parent" ? "background:#644bba; color:#ffffff; box-shadow:0 4px 10px rgba(100,75,186,0.35);" : "background:transparent; color:#484552;")"
                @onclick='() => SetRole("Parent")'>
            <span class="material-symbols-outlined" style="font-size:17px;">family_restroom</span>
            <span>Parent</span>
        </button>
        <button type="button"
                style="flex:1; border:none; padding:0.6rem 0.5rem; border-radius:0.75rem; font-size:12px; font-weight:800; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:5px; transition:all 0.2s; @(_selectedRole == "Driver" ? "background:#0c6b55; color:#ffffff; box-shadow:0 4px 10px rgba(12,107,85,0.35);" : "background:transparent; color:#484552;")"
                @onclick='() => SetRole("Driver")'>
            <span class="material-symbols-outlined" style="font-size:17px;">directions_bus</span>
            <span>Driver</span>
        </button>
        <button type="button"
                style="flex:1; border:none; padding:0.6rem 0.5rem; border-radius:0.75rem; font-size:12px; font-weight:800; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:5px; transition:all 0.2s; @(_selectedRole == "Admin" ? "background:#4338ca; color:#ffffff; box-shadow:0 4px 12px rgba(67,56,202,0.35);" : "background:transparent; color:#484552;")"
                @onclick='() => SetRole("Admin")'>
            <span class="material-symbols-outlined" style="font-size:17px;">admin_panel_settings</span>
            <span>Admin</span>
        </button>
    </div>

    <!-- Active Role Sign-In Form Card -->
    <div class="clay-card" style="padding:1.25rem; border-radius:1.5rem; margin-bottom:1.25rem;">
        
        @if (_selectedRole == "Parent")
        {
            <!-- Parent Form -->
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
                <div>
                    <h2 style="font-size:17px; font-weight:800; color:#181930; margin:0;">Parent Guardian Portal</h2>
                    <p style="font-size:12px; color:#484552; margin:0;">Track child, live stops & RFID taps</p>
                </div>
                <div style="width:2.25rem; height:2.25rem; border-radius:50%; background:#e7deff; color:#644bba; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:18px;">badge</span>
                </div>
            </div>

            <div style="margin-bottom:0.875rem;">
                <label style="display:block; font-size:11px; font-weight:700; color:#484552; margin-bottom:0.35rem; margin-left:0.25rem;">Mobile Phone Number</label>
                <div class="clay-inset" style="display:flex; align-items:center; height:3rem; padding:0 0.75rem;">
                    <!-- Clickable Country Code Pill (Tap to Select / Scroll to India) -->
                    <button type="button"
                            @onclick="() => _showCountryModal = true"
                            style="display:flex; align-items:center; gap:0.35rem; padding:0.25rem 0.5rem 0.25rem 0; margin-right:0.5rem; border-right:1px solid #cac4d4; background:none; border-top:none; border-bottom:none; border-left:none; cursor:pointer;"
                            title="Select Country Code">
                        <span style="font-size:1.15rem; line-height:1;">@_selectedCountry.Flag</span>
                        <span style="font-size:13px; font-weight:700; color:#181930;">@_selectedCountry.DialCode</span>
                        <span class="material-symbols-outlined" style="font-size:16px; color:#797584; margin-left:-2px;">arrow_drop_down</span>
                    </button>
                    <input style="width:100%; background:transparent; border:none; outline:none; font-size:14px; font-weight:600; color:#181930;" type="tel" @bind="_parentPhone" placeholder="@_phonePlaceholder" />
                </div>
            </div>

            <div style="margin-bottom:0.875rem;">
                <label style="display:block; font-size:11px; font-weight:700; color:#484552; margin-bottom:0.35rem; margin-left:0.25rem;">4-Digit Safety OTP</label>
                <div class="clay-inset" style="display:flex; align-items:center; height:3rem; padding:0 0.75rem;">
                    <span class="material-symbols-outlined" style="font-size:18px; color:#644bba; margin-right:0.5rem;">pin</span>
                    <input style="width:100%; background:transparent; border:none; outline:none; font-size:16px; font-weight:700; letter-spacing:0.2em; color:#181930;" type="text" maxlength="4" @bind="_parentOtp" placeholder="8421" />
                </div>
            </div>
        }
        else if (_selectedRole == "Driver")
        {
            <!-- Driver Form -->
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
                <div>
                    <h2 style="font-size:17px; font-weight:800; color:#181930; margin:0;">Driver In-Cab Console</h2>
                    <p style="font-size:12px; color:#484552; margin:0;">Active route, passenger roster & SOS</p>
                </div>
                <div style="width:2.25rem; height:2.25rem; border-radius:50%; background:#a1f3d7; color:#0c6b55; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:18px;">airline_seat_recline_normal</span>
                </div>
            </div>

            <div style="margin-bottom:0.875rem;">
                <label style="display:block; font-size:11px; font-weight:700; color:#484552; margin-bottom:0.35rem; margin-left:0.25rem;">Driver License / Assigned Bus</label>
                <div class="clay-inset" style="display:flex; align-items:center; height:3rem; padding:0 0.75rem;">
                    <span class="material-symbols-outlined" style="font-size:18px; color:#0c6b55; margin-right:0.5rem;">directions_bus</span>
                    <input style="width:100%; background:transparent; border:none; outline:none; font-size:14px; font-weight:600; color:#181930;" type="text" @bind="_driverId" placeholder="Bus #14 (Robert Jenkins)" />
                </div>
            </div>

            <div style="margin-bottom:0.875rem;">
                <label style="display:block; font-size:11px; font-weight:700; color:#484552; margin-bottom:0.35rem; margin-left:0.25rem;">Security PIN</label>
                <div class="clay-inset" style="display:flex; align-items:center; height:3rem; padding:0 0.75rem;">
                    <span class="material-symbols-outlined" style="font-size:18px; color:#0c6b55; margin-right:0.5rem;">lock</span>
                    <input style="width:100%; background:transparent; border:none; outline:none; font-size:16px; font-weight:700; letter-spacing:0.2em; color:#181930;" type="password" maxlength="6" @bind="_driverPin" placeholder="••••" />
                </div>
            </div>
        }
        else
        {
            <!-- Admin Form - Beautifully Optimised for Mobile Application Style Interface -->
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
                <div style="display:flex; align-items:center; gap:0.625rem;">
                    <div style="width:2.5rem; height:2.5rem; border-radius:0.75rem; background:#4338ca; color:#ffffff; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(67,56,202,0.35); flex-shrink:0;">
                        <span class="material-symbols-outlined" style="font-size:22px;">admin_panel_settings</span>
                    </div>
                    <div>
                        <div style="display:flex; align-items:center; gap:0.35rem;">
                            <h2 style="font-size:16px; font-weight:800; color:#181930; margin:0;">District Admin Portal</h2>
                            <span class="clay-badge-mint" style="font-size:9px; font-weight:800; padding:1px 6px;">DISPATCH</span>
                        </div>
                        <p style="font-size:11px; color:#484552; margin:0;">Oakridge Academy District #4</p>
                    </div>
                </div>
                <div style="width:2rem; height:2rem; border-radius:50%; background:#eeecff; color:#4338ca; display:flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:16px;">verified_user</span>
                </div>
            </div>

            <!-- Email / Staff Account -->
            <div style="margin-bottom:0.875rem;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem; margin-left:0.25rem;">
                    <label style="font-size:11px; font-weight:700; color:#484552;">Staff Email / Admin ID</label>
                    <button type="button" style="border:none; background:none; color:#4338ca; font-size:11px; font-weight:700; cursor:pointer;" @onclick='() => _adminEmail = "admin@oakridge.edu"'>Fill Demo</button>
                </div>
                <div class="clay-inset" style="display:flex; align-items:center; height:3rem; padding:0 0.75rem;">
                    <span class="material-symbols-outlined" style="font-size:18px; color:#4338ca; margin-right:0.5rem;">badge</span>
                    <input style="width:100%; background:transparent; border:none; outline:none; font-size:14px; font-weight:600; color:#181930;" type="email" @bind="_adminEmail" placeholder="admin@oakridge.edu" />
                </div>
            </div>

            <!-- Master Password with Eye Toggle -->
            <div style="margin-bottom:0.875rem;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.35rem; margin-left:0.25rem;">
                    <label style="font-size:11px; font-weight:700; color:#484552;">Password / Master Key</label>
                    <button type="button" style="border:none; background:none; color:#4338ca; font-size:11px; font-weight:700; cursor:pointer;" @onclick='() => _adminPassword = "Admin#2026!"'>Default</button>
                </div>
                <div class="clay-inset" style="display:flex; align-items:center; height:3rem; padding:0 0.75rem;">
                    <span class="material-symbols-outlined" style="font-size:18px; color:#4338ca; margin-right:0.5rem;">key</span>
                    <input style="width:100%; background:transparent; border:none; outline:none; font-size:14px; font-weight:600; color:#181930;" type="@(_showAdminPassword ? "text" : "password")" @bind="_adminPassword" placeholder="••••••••" />
                    <button type="button" style="border:none; background:none; color:#797584; cursor:pointer; padding:0 4px; display:flex; align-items:center;" @onclick="() => _showAdminPassword = !_showAdminPassword">
                        <span class="material-symbols-outlined" style="font-size:18px;">@(_showAdminPassword ? "visibility_off" : "visibility")</span>
                    </button>
                </div>
            </div>

            <!-- Live Telemetry Status Strip -->
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.5rem; padding:0.5rem 0.75rem; border-radius:0.75rem; background:#eeecff; font-size:11px; color:#484552;">
                <span style="display:flex; align-items:center; gap:0.35rem;">
                    <span style="width:7px; height:7px; border-radius:50%; background:#0c6b55; display:inline-block;"></span>
                    <span>District Fleet Gateway</span>
                </span>
                <span style="font-weight:700; color:#4338ca;">24 Corridors Live</span>
            </div>
        }

        <!-- Remember Me Checkbox (MAUI Persistent Storage) -->
        <div style="display:flex; align-items:center; gap:0.625rem; padding:0.5rem 0.25rem 0.75rem 0.25rem; cursor:pointer;" @onclick="ToggleRememberMe">
            <div style="width:1.35rem; height:1.35rem; border-radius:0.35rem; display:flex; align-items:center; justify-content:center; transition:all 0.2s; @(_rememberMe ? "background:#644bba; color:#ffffff; box-shadow:0 2px 6px rgba(100,75,186,0.35);" : "background:#eeecff; border:1px solid #cac4d4; color:transparent;")">
                <span class="material-symbols-outlined" style="font-size:16px; font-weight:800;">check</span>
            </div>
            <div style="display:flex; flex-direction:column;">
                <span style="font-size:13px; font-weight:700; color:#181930;">Remember Me on this device</span>
                <span style="font-size:11px; color:#797584;">Stay logged in across app restarts</span>
            </div>
        </div>

        <!-- Role Sign-In Button -->
        <button class="clay-btn @GetRoleButtonClass()" style="width:100%; height:3.25rem; font-size:15px; margin-top:0.25rem; @(_selectedRole == "Admin" ? "background:#4338ca; box-shadow:0 6px 16px rgba(67,56,202,0.35);" : "")" @onclick="HandleRoleLogin">
            @if (_isLoading)
            {
                <span class="material-symbols-outlined" style="animation:spin 1s infinite linear;">refresh</span>
                <span>Signing in...</span>
            }
            else
            {
                <span>@GetRoleButtonText()</span>
                <span class="material-symbols-outlined" style="font-size:20px;">arrow_forward</span>
            }
        </button>
    </div>

    <!-- Quick 1-Tap Demo Switcher (Instant Evaluation for Sir/Testers) -->
    <div style="padding:1rem; border-radius:1.5rem; background:#ffffff; box-shadow:0 8px 24px -4px rgba(41,42,66,0.08); margin-bottom:1rem;">
        <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.75rem;">
            <span class="material-symbols-outlined" style="color:#644bba; font-size:18px;">rocket_launch</span>
            <span style="font-size:12px; font-weight:800; color:#181930; text-transform:uppercase; letter-spacing:0.04em;">1-Tap Quick Demo Logins</span>
        </div>
        
        <div style="display:flex; flex-direction:column; gap:0.5rem;">
            <!-- Demo Parent -->
            <button type="button" class="clay-card" style="display:flex; align-items:center; justify-content:space-between; padding:0.6rem 0.85rem; border-radius:1rem; border:none; cursor:pointer; text-align:left; background:#fbf8ff; width:100%; transition:transform 0.1s;" @onclick='() => DemoLoginAs("Parent")'>
                <div style="display:flex; align-items:center; gap:0.6rem;">
                    <div style="width:2rem; height:2rem; border-radius:50%; background:#e7deff; color:#644bba; display:flex; align-items:center; justify-content:center;">
                        <span class="material-symbols-outlined" style="font-size:16px;">family_restroom</span>
                    </div>
                    <div>
                        <div style="font-size:12px; font-weight:800; color:#181930;">Login as Parent</div>
                        <div style="font-size:11px; color:#484552;">Sarah Jenkins (Leo • Bus #14)</div>
                    </div>
                </div>
                <span class="clay-badge clay-badge-secondary" style="font-size:10px;">ENTER</span>
            </button>

            <!-- Demo Driver -->
            <button type="button" class="clay-card" style="display:flex; align-items:center; justify-content:space-between; padding:0.6rem 0.85rem; border-radius:1rem; border:none; cursor:pointer; text-align:left; background:#fbf8ff; width:100%; transition:transform 0.1s;" @onclick='() => DemoLoginAs("Driver")'>
                <div style="display:flex; align-items:center; gap:0.6rem;">
                    <div style="width:2rem; height:2rem; border-radius:50%; background:#a1f3d7; color:#0c6b55; display:flex; align-items:center; justify-content:center;">
                        <span class="material-symbols-outlined" style="font-size:16px;">directions_bus</span>
                    </div>
                    <div>
                        <div style="font-size:12px; font-weight:800; color:#181930;">Login as Driver</div>
                        <div style="font-size:11px; color:#484552;">Robert Jenkins (Bus #14 Console)</div>
                    </div>
                </div>
                <span class="clay-badge clay-badge-mint" style="font-size:10px;">ENTER</span>
            </button>

            <!-- Demo Admin -->
            <button type="button" class="clay-card" style="display:flex; align-items:center; justify-content:space-between; padding:0.6rem 0.85rem; border-radius:1rem; border:none; cursor:pointer; text-align:left; background:#fbf8ff; width:100%; transition:transform 0.1s;" @onclick='() => DemoLoginAs("Admin")'>
                <div style="display:flex; align-items:center; gap:0.6rem;">
                    <div style="width:2rem; height:2rem; border-radius:50%; background:#eeecff; color:#4338ca; display:flex; align-items:center; justify-content:center;">
                        <span class="material-symbols-outlined" style="font-size:16px;">admin_panel_settings</span>
                    </div>
                    <div>
                        <div style="font-size:12px; font-weight:800; color:#181930;">Login as District Admin</div>
                        <div style="font-size:11px; color:#484552;">Elena Vasquez (Oakridge Academy)</div>
                    </div>
                </div>
                <span class="clay-badge clay-badge-tertiary" style="font-size:10px;">ENTER</span>
            </button>
        </div>
    </div>
</div>

<!-- Scrollable & Searchable Country Code Selection Modal -->
@if (_showCountryModal)
{
    <div style="position:fixed; inset:0; background:rgba(24,25,48,0.55); backdrop-filter:blur(6px); z-index:9999; display:flex; align-items:flex-end; justify-content:center; padding:0;" @onclick="() => _showCountryModal = false">
        <div class="clay-card" style="width:100%; max-width:460px; max-height:80vh; background:#ffffff; border-top-left-radius:1.75rem; border-top-right-radius:1.75rem; border-bottom-left-radius:0; border-bottom-right-radius:0; padding:1.25rem; display:flex; flex-direction:column; box-shadow:0 -8px 32px rgba(24,25,48,0.2);" @onclick:stopPropagation="true">
            
            <!-- Modal Header -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; padding-bottom:0.5rem; border-bottom:1px solid rgba(24,25,48,0.08);">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <div style="width:2rem; height:2rem; border-radius:50%; background:#eeecff; color:#644bba; display:flex; align-items:center; justify-content:center;">
                        <span class="material-symbols-outlined" style="font-size:18px;">public</span>
                    </div>
                    <div>
                        <h3 style="font-size:15px; font-weight:800; color:#181930; margin:0;">Select Country Code</h3>
                        <p style="font-size:11px; color:#797584; margin:0;">Scroll or search to select (e.g. India, +91)</p>
                    </div>
                </div>
                <button type="button" style="background:#eeecff; border:none; width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer;" @onclick="() => _showCountryModal = false">
                    <span class="material-symbols-outlined" style="font-size:18px; color:#181930;">close</span>
                </button>
            </div>

            <!-- Search Input -->
            <div class="clay-inset" style="display:flex; align-items:center; height:2.75rem; padding:0 0.75rem; margin-bottom:0.75rem;">
                <span class="material-symbols-outlined" style="font-size:18px; color:#797584; margin-right:0.5rem;">search</span>
                <input style="width:100%; background:transparent; border:none; outline:none; font-size:13px; font-weight:600; color:#181930;"
                       type="text"
                       placeholder="Search country or code (e.g. India, +91)..."
                       @bind="_countrySearchQuery"
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_countrySearchQuery))
                {
                    <button type="button" style="background:none; border:none; cursor:pointer; color:#797584;" @onclick='() => _countrySearchQuery = ""'>
                        <span class="material-symbols-outlined" style="font-size:16px;">clear</span>
                    </button>
                }
            </div>

            <!-- Scrollable Country List -->
            <div style="flex:1; overflow-y:auto; max-height:55vh; display:flex; flex-direction:column; gap:0.35rem; padding-right:2px;">
                @foreach (var c in FilteredCountries)
                {
                    var isSelected = _selectedCountry.Code == c.Code;
                    <button type="button"
                            style="display:flex; align-items:center; justify-content:space-between; padding:0.65rem 0.85rem; border-radius:0.875rem; border:none; cursor:pointer; text-align:left; transition:all 0.15s; @(isSelected ? "background:#eeecff; border:1.5px solid #644bba;" : "background:#fbf8ff; border:1px solid rgba(24,25,48,0.05);")"
                            @onclick="() => SelectCountry(c)">
                        <div style="display:flex; align-items:center; gap:0.75rem;">
                            <span style="font-size:1.4rem;">@c.Flag</span>
                            <div>
                                <div style="font-size:13px; font-weight:700; color:#181930;">@c.Name</div>
                                <div style="font-size:11px; color:#797584;">@c.Code</div>
                            </div>
                        </div>
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <span style="font-size:13px; font-weight:800; color:#4338ca;">@c.DialCode</span>
                            @if (isSelected)
                            {
                                <span class="material-symbols-outlined" style="font-size:18px; color:#644bba;">check_circle</span>
                            }
                        </div>
                    </button>
                }
            </div>
        </div>
    </div>
}

