    {
        _isLoading = true;
        StateHasChanged();

        await Task.Delay(300); // Gentle UI transition

        if (_rememberMe)
        {
            Preferences.Default.Set("ST_RememberMe", true);
            Preferences.Default.Set("ST_SavedRole", _selectedRole);
        }
        else
        {
            Preferences.Default.Remove("ST_RememberMe");
            Preferences.Default.Remove("ST_SavedRole");
        }

        RedirectToRole(_selectedRole);
        _isLoading = false;
    }

