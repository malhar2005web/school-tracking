@page "/not-found"
@layout MainLayout

<div style="min-height:60vh; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:2rem 1rem;">
    <div style="width:4.5rem; height:4.5rem; border-radius:50%; background:#eeecff; color:#644bba; display:flex; align-items:center; justify-content:center; margin-bottom:1rem; box-shadow:0 8px 20px rgba(100,75,186,0.2);">
        <span class="material-symbols-outlined" style="font-size:36px;">explore_off</span>
    </div>
    <h2 style="font-size:20px; font-weight:800; color:#181930; margin:0 0 0.5rem 0;">Page Not Found</h2>
    <p style="font-size:13px; color:#484552; max-width:280px; margin:0 0 1.5rem 0;">The transit view or safety route you are trying to reach is not available.</p>
    <a href="/" class="clay-btn clay-btn-primary" style="padding:0.625rem 1.5rem;">
        <span class="material-symbols-outlined" style="font-size:18px;">home</span>
        <span>Return to Dashboard</span>
    </a>
</div>
