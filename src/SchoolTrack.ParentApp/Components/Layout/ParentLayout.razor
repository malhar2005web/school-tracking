@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject ParentAuthState AuthState
@inject IParentNotificationService NotificationService
@inject ParentTrackingHubService TrackingHub
@implements IDisposable

<div style="min-height:100vh; background:#fbf8ff; display:flex; flex-direction:column; position:relative;">
    <!-- Top Header Bar -->
    <header class="clay-header" style="position:fixed; top:0; left:0; right:0; z-index:50; background:rgba(251,248,255,0.95); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); box-shadow:0 2px 12px rgba(24,25,48,0.06); padding-top:env(safe-area-inset-top, 0px);">
        <div style="height:3.75rem; padding:0 1rem; display:flex; align-items:center; justify-content:space-between;">
            <div style="display:flex; align-items:center; gap:0.625rem; cursor:pointer;" @onclick='() => Navigation.NavigateTo("/parent/dashboard")'>
                <div style="width:2.25rem; height:2.25rem; border-radius:50%; background:#644bba; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 10px rgba(100,75,186,0.35);">
                    <span class="material-symbols-outlined" style="font-size:1.25rem; color:#ffffff;">directions_bus</span>
                </div>
                <div style="display:flex; flex-direction:column;">
                    <div style="display:flex; align-items:center; gap:0.35rem;">
                        <span style="font-size:11px; font-weight:800; color:#644bba; text-transform:uppercase; letter-spacing:0.05em; line-height:1;">SchoolTrack</span>
                        <span class="clay-badge-mint" style="font-size:9px; font-weight:800; padding:1px 5px;">PARENT</span>
                    </div>
                    <h1 style="font-size:16px; font-weight:800; color:#181930; margin:0; line-height:1.2;">@PageTitle</h1>
                </div>
            </div>

            <div style="display:flex; align-items:center; gap:0.5rem;">
                <!-- Notification Bell -->
                <button aria-label="Notifications" style="width:2.25rem; height:2.25rem; border-radius:50%; background:#ffffff; display:flex; align-items:center; justify-content:center; color:#181930; border:none; box-shadow:0 2px 8px rgba(24,25,48,0.06); position:relative; cursor:pointer;" @onclick="ToggleNotificationDrawer">
                    <span class="material-symbols-outlined" style="font-size:18px;">notifications</span>
                    @if (HasUnreadNotifications)
                    {
                        <span style="position:absolute; top:4px; right:4px; width:7px; height:7px; border-radius:50%; background:#ba1a1a;"></span>
                    }
                </button>

                <!-- Logout / Switch Role Button -->
                <button title="Log Out / Switch Role" style="width:2.25rem; height:2.25rem; border-radius:50%; background:#fee2e2; border:none; display:flex; align-items:center; justify-content:center; color:#ba1a1a; cursor:pointer; box-shadow:0 2px 6px rgba(186,26,26,0.15);" @onclick="Logout">
                    <span class="material-symbols-outlined" style="font-size:18px;">logout</span>
                </button>

                <!-- Parent Profile Avatar Button -->
                <button aria-label="Parent Profile" style="width:2.25rem; height:2.25rem; border-radius:50%; padding:2px; background:#ffffff; box-shadow:0 2px 8px rgba(24,25,48,0.08); border:none; display:flex; align-items:center; justify-content:center; cursor:pointer;" @onclick='() => Navigation.NavigateTo("/parent/profile")'>
                    <img alt="Parent Profile" style="width:1.85rem; height:1.85rem; border-radius:50%; object-fit:cover;" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDHDGGSb8ANzaCZHCqofS-D-q4PgE7LT1WDcNKEqXolmjZqzx7dVVsLOLj85ClQIyilXqCh1xf1tJkV8gKAjJl1_u4HtkDaiDkJLDGFcZWLsXzPvZwzKer8q8QksP-Qtn77MSo-jbMHx3Rv4Hei7m60y6xO321AHTZVm3-QFuxk0U03SJKd2ZlyuyTxQXYbOWTRwgEwJQBdCNMqwEJ0qxUON7pENAhrXVPYmVOgXRA" />
                </button>
            </div>
        </div>
    </header>

    <!-- Floating Real-Time In-App Toast Container -->
    @if (NotificationService.ActiveToasts.Count > 0)
    {
        <div class="floating-toast-container">
            @foreach (var toast in NotificationService.ActiveToasts)
            {
                var isProximity = toast.Type == "ProximityPreArrival";
                <div class="floating-toast-pill" style="@(isProximity ? "border: 1.5px solid #644bba; background: #ffffff; box-shadow: 0 10px 28px rgba(100,75,186,0.22);" : "")">
                    <div style="display:flex; align-items:center; gap:0.75rem; min-width:0; flex:1;">
                        <div style="width:2.25rem; height:2.25rem; border-radius:50%; background:@(isProximity ? "#eeecff" : "#a1f3d7"); color:@(isProximity ? "#644bba" : "#0c6b55"); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <span class="material-symbols-outlined" style="font-size:18px;">@(isProximity ? "near_me" : "contactless")</span>
                        </div>
                        <div style="display:flex; flex-direction:column; min-width:0; flex:1;">
                            <span style="font-size:12px; font-weight:800; color:#181930;">@toast.Title</span>
                            <span style="font-size:11px; color:#484552; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@toast.Message</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(toast.ActionLabel))
                    {
                        <button class="clay-btn clay-btn-primary" style="padding:0.25rem 0.6rem; font-size:10px; font-weight:800; background:#644bba; margin-right:0.25rem; white-space:nowrap;" @onclick='() => Navigation.NavigateTo(toast.ActionTarget ?? "/parent/dashboard")'>
                            @toast.ActionLabel
                        </button>
                    }
                    <button style="background:none; border:none; color:#797584; cursor:pointer;" @onclick="() => NotificationService.DismissToast(toast.Id)">
                        <span class="material-symbols-outlined" style="font-size:18px;">close</span>
                    </button>
                </div>
            }
        </div>
    }

    <!-- Main Content Area -->
    <main style="flex:1; width:100%; min-height:100vh; padding-top:calc(4.5rem + env(safe-area-inset-top, 0px)); padding-bottom:6.5rem; background:#fbf8ff;">
        @Body
    </main>

    <!-- Fixed Floating Clay Bottom Navigation Bar -->
    <div style="position:fixed; bottom:0; left:0; right:0; z-index:50; padding:0 1rem; padding-bottom:env(safe-area-inset-bottom, 12px); pointer-events:none; margin-bottom:0.75rem;">
        <nav class="clay-nav" style="pointer-events:auto; margin:0 auto; max-width:28rem; background:rgba(255,255,255,0.95); backdrop-filter:blur(16px); border-radius:3rem; padding:0.375rem; display:flex; align-items:center; justify-content:space-around; box-shadow:0 12px 32px rgba(24,25,48,0.12);">
            <a style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; padding:0.5rem 1rem; border-radius:2rem; font-size:11px; font-weight:700; text-decoration:none; min-width:64px; transition:all 0.2s; @(IsActive("/parent/dashboard") ? "background:#644bba; color:#ffffff; box-shadow:0 4px 10px rgba(100,75,186,0.35);" : "color:#484552;")" href="/parent/dashboard">
                <span class="material-symbols-outlined" style="font-size:22px;">home</span>
                <span>Home</span>
            </a>
            <a style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; padding:0.5rem 1rem; border-radius:2rem; font-size:11px; font-weight:700; text-decoration:none; min-width:64px; transition:all 0.2s; @(IsActive("/parent/live-map") ? "background:#644bba; color:#ffffff; box-shadow:0 4px 10px rgba(100,75,186,0.35);" : "color:#484552;")" href="/parent/live-map">
                <span class="material-symbols-outlined" style="font-size:22px;">near_me</span>
                <span>Tracking</span>
            </a>
            <a style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; padding:0.5rem 1rem; border-radius:2rem; font-size:11px; font-weight:700; text-decoration:none; min-width:64px; transition:all 0.2s; @(IsActive("/parent/history") ? "background:#644bba; color:#ffffff; box-shadow:0 4px 10px rgba(100,75,186,0.35);" : "color:#484552;")" href="/parent/history">
                <span class="material-symbols-outlined" style="font-size:22px;">receipt_long</span>
                <span>History</span>
            </a>
            <a style="display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; padding:0.5rem 1rem; border-radius:2rem; font-size:11px; font-weight:700; text-decoration:none; min-width:64px; transition:all 0.2s; @(IsActive("/parent/profile") ? "background:#644bba; color:#ffffff; box-shadow:0 4px 10px rgba(100,75,186,0.35);" : "color:#484552;")" href="/parent/profile">
                <span class="material-symbols-outlined" style="font-size:22px;">manage_accounts</span>
                <span>Profile</span>
            </a>
        </nav>
    </div>

    <!-- Notification Drawer Slide-Up Modal -->
    @if (_showNotificationDrawer)
    {
        <div class="clay-modal-backdrop" @onclick="ToggleNotificationDrawer">
            <div class="clay-bottom-sheet" @onclick:stopPropagation="true">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem;">
                    <div style="display:flex; align-items:center; gap:0.5rem;">
                        <span class="material-symbols-outlined" style="color:#644bba;">notifications_active</span>
                        <h2 style="font-size:16px; font-weight:800; color:#181930; margin:0;">Safety Notifications</h2>
                    </div>
                    <button style="border:none; background:none; color:#797584; cursor:pointer;" @onclick="ToggleNotificationDrawer">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div style="display:flex; flex-direction:column; gap:0.75rem; max-height:50vh; overflow-y:auto;">
                    <div style="padding:0.75rem; border-radius:1rem; background:#e8f8f3; display:flex; gap:0.75rem; align-items:flex-start;">
                        <span class="material-symbols-outlined" style="color:#0c6b55; font-size:22px;">check_circle</span>
                        <div>
                            <div style="font-size:13px; font-weight:700; color:#181930;">Morning Route In Transit</div>
                            <p style="font-size:12px; color:#484552; margin:2px 0 0 0;">Bus #14 is approaching your designated pickup point.</p>
                            <span style="font-size:10px; color:#797584;">Just now</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _showNotificationDrawer = false;
    private bool HasUnreadNotifications = true;

    private string PageTitle
    {
        get
        {
            var uri = Navigation.Uri.ToLowerInvariant();
            if (uri.Contains("/live-map")) return "Live Map Tracker";
            if (uri.Contains("/history")) return "Transit History";
            if (uri.Contains("/profile")) return "Parent Account";
            return "Dashboard";
        }
    }

    private bool IsActive(string path)
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        var target = path.TrimStart('/').ToLowerInvariant();
        if (string.IsNullOrEmpty(current) && target.Contains("dashboard")) return true;
        return current.Contains(target);
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleStateChanged;
        NotificationService.OnNotificationReceived += HandleNotification;

        try
        {
            await TrackingHub.StartAsync();
        }
        catch { }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleNotification(ParentNotificationModel notif)
    {
        HasUnreadNotifications = true;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNotificationDrawer()
    {
        _showNotificationDrawer = !_showNotificationDrawer;
        if (!_showNotificationDrawer)
        {
            HasUnreadNotifications = false;
        }
    }

    private void Logout()
    {
        Preferences.Default.Remove("ST_RememberMe");
        Preferences.Default.Remove("ST_SavedRole");
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleStateChanged;
        NotificationService.OnNotificationReceived -= HandleNotification;
    }
}

