@page "/login"
@layout MainLayout
@inject IDriverApiClient DriverApi
@inject DriverAuthState AuthState
@inject NavigationManager Navigation
@inject IDriverNotificationService NotificationService

<div style="min-height:100vh; background:#fbf8ff; display:flex; flex-direction:column; justify-content:center; align-items:center; padding:1.5rem;">
    <div class="clay-card" style="width:100%; max-width:26rem; padding:2rem 1.5rem; border-radius:1.5rem; background:#ffffff; box-shadow:0 16px 36px rgba(24,25,48,0.08); text-align:center;">
        <!-- Ollie Bus Icon -->
        <div style="width:4.5rem; height:4.5rem; border-radius:50%; background:#0c6b55; color:#ffffff; display:flex; align-items:center; justify-content:center; margin:0 auto 1.25rem auto; box-shadow:0 8px 20px rgba(12,107,85,0.35);">
            <span class="material-symbols-outlined" style="font-size:36px;">directions_bus</span>
        </div>

        <h1 style="font-size:1.5rem; font-weight:800; color:#181930; margin-bottom:0.25rem; letter-spacing:-0.02em;">
            Driver In-Cab Console
        </h1>
        <p style="font-size:0.875rem; color:#484552; margin-bottom:1.75rem;">
            Authenticate driver terminal to synchronize vehicle GPS, door RFID scanners, and route manifest.
        </p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div style="background:#ffdad6; color:#ba1a1a; padding:0.75rem; border-radius:0.75rem; font-size:0.85rem; font-weight:700; margin-bottom:1.25rem; text-align:left; display:flex; align-items:center; gap:0.5rem;">
                <span class="material-symbols-outlined" style="font-size:18px;">error</span>
                <span>@ErrorMessage</span>
            </div>
        }

        <form @onsubmit="HandleLogin" style="display:flex; flex-direction:column; gap:1.25rem; text-align:left;">
            <div>
                <label style="display:block; font-size:0.75rem; font-weight:800; color:#484552; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.375rem;">
                    Commercial Driver License (CDL)
                </label>
                <div style="position:relative;">
                    <span class="material-symbols-outlined" style="position:absolute; left:0.875rem; top:50%; transform:translateY(-50%); color:#797584; font-size:20px;">badge</span>
                    <input type="text"
                           @bind="LicenseNumber"
                           required
                           placeholder="e.g. CDL-90824-A"
                           style="width:100%; padding:0.875rem 1rem 0.875rem 2.75rem; border-radius:0.875rem; border:1px solid #cac4d4; background:#f5f2ff; font-size:0.95rem; font-weight:600; color:#181930; outline:none;" />
                </div>
            </div>

            <div>
                <label style="display:block; font-size:0.75rem; font-weight:800; color:#484552; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.375rem;">
                    Terminal Security PIN
                </label>
                <div style="position:relative;">
                    <span class="material-symbols-outlined" style="position:absolute; left:0.875rem; top:50%; transform:translateY(-50%); color:#797584; font-size:20px;">lock</span>
                    <input type="password"
                           @bind="Pin"
                           required
                           maxlength="6"
                           placeholder="••••"
                           style="width:100%; padding:0.875rem 1rem 0.875rem 2.75rem; border-radius:0.875rem; border:1px solid #cac4d4; background:#f5f2ff; font-size:0.95rem; font-weight:600; color:#181930; outline:none;" />
                </div>
            </div>

            <button type="submit"
                    disabled="@IsLoading"
                    class="clay-button-solid"
                    style="margin-top:0.5rem; background:#0c6b55; color:#ffffff; border:none; padding:1rem; border-radius:1rem; font-weight:800; font-size:1rem; cursor:pointer; box-shadow:0 6px 18px rgba(12,107,85,0.35); display:flex; align-items:center; justify-content:center; gap:0.5rem;">
                @if (IsLoading)
                {
                    <span class="material-symbols-outlined" style="animation:spin 1s infinite; font-size:20px;">progress_activity</span>
                    <span>Connecting Hardware...</span>
                }
                else
                {
                    <span class="material-symbols-outlined" style="font-size:20px;">key</span>
                    <span>Sign In & Activate Cab</span>
                }
            </button>
        </form>

        <div style="margin-top:1.5rem; padding-top:1.25rem; border-top:1px dashed #cac4d4;">
            <p style="font-size:0.775rem; color:#484552; margin-bottom:0.75rem; font-weight:600;">
                Quick Demo Access (Pre-assigned Bus #14):
            </p>
            <button @onclick="DemoLogin"
                    style="width:100%; background:#e7deff; color:#310b87; border:1px solid #ccbeff; padding:0.75rem; border-radius:0.875rem; font-size:0.85rem; font-weight:800; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:0.5rem;">
                <span class="material-symbols-outlined" style="font-size:18px;">account_circle</span>
                <span>Continue as Robert Jenkins (Bus #14)</span>
            </button>
        </div>
    </div>
</div>

@code {
    private string LicenseNumber { get; set; } = "CDL-90824-A";
    private string Pin { get; set; } = "1234";
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var session = await DriverApi.LoginAsync(LicenseNumber, Pin);
            if (session != null)
            {
                AuthState.SetSession(session);
                NotificationService.ShowToast("Welcome, Driver", $"In-cab terminal linked to {session.BusNumber}.", "Success");
                Navigation.NavigateTo("/");
            }
            else
            {
                ErrorMessage = "Invalid CDL number or security PIN. Please contact School Dispatch.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Authentication error: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void DemoLogin()
    {
        AuthState.InitializeDefaultDemoSession();
        NotificationService.ShowToast("Driver Terminal Active", "Logged in as Robert Jenkins • Bus #14.", "Success");
        Navigation.NavigateTo("/");
    }
}

