@page "/login"
@layout Layout.MainLayout
@inject IApiClient ApiClient
@inject AdminAuthStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Login — SchoolTrack Fleet Safety</PageTitle>

<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 2rem 0;">
    <div class="clay-card" style="width: 100%; max-width: 28rem; padding: 2.5rem; background: #ffffff;">
        <!-- Header & Mascot -->
        <div style="display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 2rem;">
            <div style="width: 4rem; height: 4rem; border-radius: 9999px; background: var(--color-primary); color: #ffffff; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; box-shadow: inset 0 3px 2px rgba(255,255,255,0.45), 0 10px 20px -4px rgba(100,75,186,0.5);">
                <span class="material-symbols-outlined" style="font-size: 2.25rem;">directions_bus</span>
            </div>
            <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--color-on-surface); margin: 0 0 0.5rem 0; letter-spacing: -0.02em;">SchoolTrack Admin</h1>
            <p style="font-size: 0.875rem; color: var(--color-on-surface-variant); margin: 0;">Multi-School Fleet & Transit Safety Management</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="clay-inset" style="padding: 0.75rem 1rem; border-left: 4px solid var(--color-error); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; color: var(--color-error); font-size: 0.8125rem; font-weight: 600;">
                <span class="material-symbols-outlined" style="font-size: 1.25rem;">error</span>
                <span>@_errorMessage</span>
            </div>
        }

        <!-- Login Form -->
        <EditForm Model="_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                <div>
                    <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-on-surface-variant); margin-bottom: 0.375rem;">Staff Email</label>
                    <InputText @bind-Value="_model.Email" class="clay-input" placeholder="elena.vasquez@oakridge.edu" />
                </div>

                <div>
                    <label style="display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-on-surface-variant); margin-bottom: 0.375rem;">Password</label>
                    <InputText @bind-Value="_model.Password" type="password" class="clay-input" placeholder="••••••••••••" />
                </div>

                <!-- Quick Fill Demo Pills -->
                <div>
                    <span style="display: block; font-size: 0.6875rem; font-weight: 600; color: var(--color-on-surface-variant); margin-bottom: 0.375rem;">Quick Demo Fill:</span>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <button type="button" class="clay-badge clay-badge-primary" style="border: none; cursor: pointer;" @onclick="FillSchoolAdmin">
                            School Admin (Elena)
                        </button>
                        <button type="button" class="clay-badge clay-badge-secondary" style="border: none; cursor: pointer;" @onclick="FillSystemAdmin">
                            System Admin
                        </button>
                    </div>
                </div>

                <button type="submit" class="clay-btn clay-btn-primary" style="width: 100%; height: 3.25rem; font-size: 1rem; margin-top: 0.5rem;" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="pulse-dot">Signing in...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined">login</span>
                        <span>Sign In to Admin Portal</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel _model = new()
    {
        Email = "elena.vasquez@oakridge.edu",
        Password = "AdminSecurePassword123!"
    };

    private bool _isLoading = false;
    private string? _errorMessage;

    private void FillSchoolAdmin()
    {
        _model.Email = "elena.vasquez@oakridge.edu";
        _model.Password = "AdminSecurePassword123!";
    }

    private void FillSystemAdmin()
    {
        _model.Email = "superadmin@schooltrack.com";
        _model.Password = "SuperAdminPassword123!";
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var req = new LoginRequest(_model.Email, _model.Password);
            var res = await ApiClient.LoginAsync(req);

            if (res != null)
            {
                AuthState.SetSession(new AuthSession
                {
                    AccessToken = res.AccessToken,
                    RefreshToken = res.RefreshToken,
                    ExpiresAtUtc = res.ExpiresAtUtc.UtcDateTime,
                    UserId = res.User.Id,
                    FullName = res.User.FullName,
                    Email = res.User.Email,
                    Role = res.User.Role,
                    SchoolId = res.User.SchoolId ?? Guid.Parse("11111111-1111-1111-1111-111111111111"),
                    SchoolName = res.User.SchoolName ?? "Oakridge Academy District #4"
                });

                Navigation.NavigateTo("/");
            }
            else
            {
                _errorMessage = "Invalid email or password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Sign-in error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}

